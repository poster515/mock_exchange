<sbe:messageSchema
    xmlns:sbe="http://fixprotocol.io/2016/sbe"
    package="exchange.order"
    id="1"
    version="1"
    semanticVersion="1.0"
    byteOrder="littleEndian">

    <types>

        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
            <type name="timestamp" primitiveType="uint64"/>
            <type name="srcAgentId" primitiveType="uint64"/>
        </composite>

        <enum name="Side" encodingType="uint8">
            <validValue name="Buy">1</validValue>
            <validValue name="Sell">2</validValue>
        </enum>

        <enum name="OrderType" encodingType="uint8">
            <validValue name="Market">1</validValue>
            <validValue name="Limit">2</validValue>
        </enum>

        <enum name="TimeInForce" encodingType="uint8">
            <validValue name="Day">0</validValue>
            <validValue name="IOC">3</validValue>
        </enum>

        <type name="price" primitiveType="int32"/>
        <type name="price_factor" primitiveType="int32"/>
        <type name="qty" primitiveType="uint32"/>
        <type name="orderId" primitiveType="uint64"/>
        <type name="symbolName" primitiveType="char" length="8"/>
        <type name="symbolId" primitiveType="uint64"/>
        <type name="timestamp" primitiveType="uint64"/>
        <type name="agentName" primitiveType="char" length="64"/>
        <type name="reason" primitiveType="char" length="64"/>

    </types>


    <message name="NewOrderSingle" id="1">
        <field name="orderId" id="1" type="orderId"/>
        <field name="symbolId" id="56" type="symbolId"/>
        <field name="side" id="54" type="Side"/>
        <field name="orderQty" id="38" type="qty"/>
        <field name="ordType" id="40" type="OrderType"/>
        <field name="price" id="44" type="price"/>
        <field name="priceFactor" id="45" type="price_factor"/>
        <field name="timeInForce" id="59" type="TimeInForce"/>
    </message>


    <message name="CancelOrder" id="2">
        <field name="orderId" id="1" type="orderId"/>
        <field name="symbolId" id="56" type="symbolId"/>
        <field name="side" id="54" type="Side"/>
    </message>


    <message name="ReplaceOrder" id="3">
        <field name="orderId" id="1" type="orderId"/>
        <field name="newQty" id="38" type="qty"/>
        <field name="newPrice" id="44" type="price"/>
        <field name="newPriceFactor" id="45" type="price_factor"/>
    </message>

    <message name="NewSymbolAdd" id="100">
        <field name="symbolName" id="55" type="symbolName"/>
        <field name="symbolId" id="56" type="symbolId"/>
        <field name="creationTs" id="57" type="timestamp"/>
    </message>

    <message name="AgentShutdown" id="101">
        <field name="destAgentId" id="56" type="uint64"/>
        <field name="destAgentName" id="58" type="agentName"/>
        <field name="reason" id="57" type="reason"/>
    </message>

    <message name="AllAgentShutdown" id="102">
        <field name="reason" id="57" type="reason"/>
    </message>

    <message name="AgentStartup" id="103">
        <field name="srcAgentName" id="56" type="agentName"/>
    </message>

    <message name="AgentParams" id="104">
        <field name="agentId" id="56" type="uint64"/>
        <field name="totalCash" id="57" type="int32"/>
        <field name="totalLossLimit" id="58" type="int32"/>
        <field name="totalNotional" id="59" type="int32"/>
    </message>

</sbe:messageSchema>